{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User unique identifier matching auth.uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 40
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Request": {
      "title": "Request",
      "description": "Cyber crime or consultation help request submitted by a user",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Public reference ID e.g. CCPB-2026-XXXX",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID or creator identifier",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the requester",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Email address of requester",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 30
        },
        "subject": {
          "type": "string",
          "description": "Subject of the cybersecurity request",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Detailed incident or consultation message",
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "description": "Current lifecycle status",
          "enum": ["Submitted", "Received", "Under Review", "Reviewed", "Responded", "Resolved", "Closed"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 40
        }
      },
      "required": ["requestId", "userId", "fullName", "email", "subject", "message", "status", "createdAt"]
    },
    "ResponseItem": {
      "title": "ResponseItem",
      "description": "Official administrative response or user follow-up message",
      "type": "object",
      "properties": {
        "responseId": {
          "type": "string",
          "description": "Unique response ID",
          "maxLength": 64
        },
        "requestId": {
          "type": "string",
          "description": "Associated request ID",
          "maxLength": 64
        },
        "senderRole": {
          "type": "string",
          "description": "Role of the sender",
          "enum": ["admin", "user"],
          "maxLength": 20
        },
        "senderName": {
          "type": "string",
          "description": "Name of the responder",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Response content",
          "maxLength": 3000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of response",
          "maxLength": 40
        }
      },
      "required": ["responseId", "requestId", "senderRole", "senderName", "message", "createdAt"]
    },
    "WebsiteContent": {
      "title": "WebsiteContent",
      "description": "CMS editable content for the public landing page",
      "type": "object",
      "properties": {
        "siteTitle": {
          "type": "string",
          "description": "Main portal title",
          "maxLength": 120
        },
        "heroHeading": {
          "type": "string",
          "description": "Hero section heading",
          "maxLength": 200
        },
        "heroSubheading": {
          "type": "string",
          "description": "Hero section description",
          "maxLength": 600
        },
        "aboutText": {
          "type": "string",
          "description": "About section detailed text",
          "maxLength": 2000
        },
        "ctaText": {
          "type": "string",
          "description": "Primary call to action button label",
          "maxLength": 60
        },
        "contactEmail": {
          "type": "string",
          "description": "Official support email",
          "maxLength": 254
        },
        "contactPhone": {
          "type": "string",
          "description": "Official hotline or emergency phone",
          "maxLength": 40
        },
        "contactAddress": {
          "type": "string",
          "description": "Operating address or jurisdiction",
          "maxLength": 200
        },
        "pgpKeyFingerprint": {
          "type": "string",
          "description": "PGP key fingerprint for encrypted submissions",
          "maxLength": 100
        },
        "footerText": {
          "type": "string",
          "description": "Footer copyright and disclaimer text",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last edit",
          "maxLength": 40
        }
      },
      "required": ["siteTitle", "heroHeading", "heroSubheading", "aboutText", "ctaText", "contactEmail"]
    },
    "SocialLink": {
      "title": "SocialLink",
      "description": "Configurable social media link for public display",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Social link identifier",
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "description": "Platform name e.g. GitHub, X, LinkedIn",
          "maxLength": 50
        },
        "url": {
          "type": "string",
          "description": "Validated profile URL",
          "maxLength": 300
        },
        "handle": {
          "type": "string",
          "description": "Display username or handle",
          "maxLength": 80
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether link is shown on public page"
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        }
      },
      "required": ["id", "platform", "url", "enabled", "order"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and administrative audit event",
      "type": "object",
      "properties": {
        "logId": {
          "type": "string",
          "description": "Unique audit log ID",
          "maxLength": 64
        },
        "action": {
          "type": "string",
          "description": "Type of action taken",
          "maxLength": 100
        },
        "actor": {
          "type": "string",
          "description": "Actor identifier or email",
          "maxLength": 120
        },
        "target": {
          "type": "string",
          "description": "Target resource or entity",
          "maxLength": 120
        },
        "ipAddress": {
          "type": "string",
          "description": "Observed client IP address",
          "maxLength": 64
        },
        "userAgent": {
          "type": "string",
          "description": "Client user-agent string",
          "maxLength": 300
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the event",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "description": "Result status e.g. success, failure, blocked",
          "maxLength": 30
        }
      },
      "required": ["logId", "action", "actor", "timestamp", "status"]
    },
    "BlockedIp": {
      "title": "BlockedIp",
      "description": "Malicious or abusive IP address restricted by security layer",
      "type": "object",
      "properties": {
        "ipAddress": {
          "type": "string",
          "description": "The blocked IPv4 or IPv6 address",
          "maxLength": 64
        },
        "reason": {
          "type": "string",
          "description": "Reason for blocking",
          "maxLength": 200
        },
        "blockedAt": {
          "type": "string",
          "description": "Timestamp when block was applied",
          "maxLength": 40
        },
        "blockedBy": {
          "type": "string",
          "description": "Admin identity or WAF automation",
          "maxLength": 100
        }
      },
      "required": ["ipAddress", "reason", "blockedAt", "blockedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document owned strictly by userId"
    },
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Help request submissions. Created by user, read strictly by owner or admin."
    },
    "/requests/{requestId}/responses/{responseId}": {
      "schema": "ResponseItem",
      "description": "Responses and dialogue for a request. Accessible only by request owner and admin."
    },
    "/website_content/landing": {
      "schema": "WebsiteContent",
      "description": "Configurable landing page content. Publicly readable, admin editable."
    },
    "/social_links/{linkId}": {
      "schema": "SocialLink",
      "description": "Social media links. Publicly readable, admin editable."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative security audit trail. Admin-only read, server/admin create."
    },
    "/blocked_ips/{ip}": {
      "schema": "BlockedIp",
      "description": "Security blocked IP address records. Admin-only access."
    }
  }
}
